# Application
APP_NAME=go-starter-kit
APP_HOST=0.0.0.0
APP_PORT=8080
APP_VERSION=0.1.0
APP_ENV=development
APP_TIME_ZONE=Asia/Jakarta
APP_DEBUG=false

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=go_starter
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta
DB_MAX_IDLE_CONNECTION=10
DB_MAX_OPEN_CONNECTION=100
DB_MAX_CONN_LIFE_TIME=30m

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASS=
REDIS_INDEX=0

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# OpenTelemetry
OTEL_COLLECTOR_ADDR=localhost:4317
OTEL_SERVICE_NAME=go-starter-kit
